[nemesis]
version=1.1
id=tilepad
name=Tilepad
type=application,service
package-version=1.1.2
short-desc=Star-hold launcher with Wi-Fi, ADB, preconditioning and Tweaks
detailed-desc=Hold the steering-wheel star for a grid of tiles: Wi-Fi, ADB, preconditioning and shortcuts, plus bundled Tweaks: DST, startup brief, heaters, track swap, pop-over, climate sync, Driver Only, projection and Charge-Away. Reboot after installing.
depends=!paytondev.launchpad
os=any
models=any
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=longstar
kind=sh
path=svc/longstar.sh
uid=root
mode=restart
