[nemesis]
version=1.1
id=tilepad
name=Tilepad
type=application,service
package-version=1.0.0
short-desc=Star-hold launcher with Wi-Fi, ADB, preconditioning and Tweaks
detailed-desc=Hold the steering-wheel star for a grid of tiles and bundled Tweaks: automatic DST, startup-brief bypass, cold-boot heaters, track-button swap, right-panel controls and climate sync. No store or extra service. Reboot after installing.
depends=!paytondev.launchpad
os=any
models=any
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root

[service.0]
name=longstar
kind=sh
path=svc/longstar.sh
uid=root
mode=restart
